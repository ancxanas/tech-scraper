# Get your API key from https://brightdata.com/cp/setting/users
BRIGHTDATA_API_KEY=your_key_here

# Bright Data zones (create at https://brightdata.com/cp/web_access/new)
SERP_ZONE=serp_api1
UNLOCKER_ZONE=cli_unlocker

# Custom collector IDs (optional — defaults are hardcoded)
# Create via Bright Data dashboard or REST API, then set here
# FLIPKART_COLLECTOR_ID=c_your_flipkart_collector
# RELIANCE_COLLECTOR_ID=c_your_reliance_collector
# TATACLIQ_COLLECTOR_ID=c_your_tatacliq_collector
# AMAZON_COLLECTOR_ID=c_your_amazon_collector
