{
  "tasks": {
    "dev": "deno run --unstable-kv --allow-net --allow-env --allow-read --allow-write main.ts",
    "test": "deno test --allow-env --allow-read --allow-write tests/",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno fmt --check && deno lint && deno check main.ts && deno test --allow-env --allow-read --allow-write tests/",
    "find": "deno run --unstable-kv --allow-net --allow-env --allow-read --allow-write main.ts find",
    "rank": "deno run --allow-env --allow-read --allow-write main.ts rank"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.2",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.2",
    "@cliffy/table": "jsr:@cliffy/table@^1.2",
    "@cliffy/ansi": "jsr:@cliffy/ansi@^1.2",
    "@std/assert": "jsr:@std/assert@^1.0"
  }
}
